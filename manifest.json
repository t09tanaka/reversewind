{
  "manifest_version": 3,
  "name": "Reversewind",
  "version": "0.1.0",
  "description": "Copy any web element as HTML + Tailwind CSS from the right-click menu",
  "permissions": ["contextMenus", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
