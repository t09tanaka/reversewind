{
  "manifest_version": 3,
  "name": "Reversewind",
  "version": "0.3.0",
  "description": "Copy any web element as HTML + Tailwind CSS from the right-click menu",
  "permissions": ["contextMenus", "clipboardWrite", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
